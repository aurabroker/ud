---
/**
 * Znak.astro — fasetowana litera U.
 *
 * To jest odrys z przysłanego podglądu rastrowego. Kiedy trafią do repo
 * oryginalne pliki SVG (design/brand/), podmieniamy tutaj i znak poprawia się
 * wszędzie naraz.
 */
interface Props { wysokosc?: number; klasa?: string }
const { wysokosc = 28, klasa = '' } = Astro.props;
const szerokosc = Math.round((wysokosc * 80) / 94);
---
<svg width={szerokosc} height={wysokosc} viewBox="0 0 80 94" class={klasa}
     role="img" aria-label="UtrataDochodu.pl" focusable="false">
