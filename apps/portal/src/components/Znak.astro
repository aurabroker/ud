  <polygon points="28,8 19,26 28,32" fill="#29ADE4"></polygon>
  <polygon points="10,32 19,26 28,32" fill="#5CC6EF"></polygon>
  <polygon points="10,32 28,32 19,50" fill="#8FD5F3"></polygon>
  <polygon points="10,32 19,50 10,56" fill="#B3E3F8"></polygon>
  <polygon points="28,32 19,50 28,56" fill="#1697CE"></polygon>
  <polygon points="10,56 19,50 28,56" fill="#5CC6EF"></polygon>
