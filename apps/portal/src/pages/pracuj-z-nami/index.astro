---
/**
 * Strona dla agentów innych sieci. Osobny adres, bo szuka jej zupełnie inna
 * osoba niż reszty serwisu — agent życiowy, nie klient końcowy.
 */
import Baza from '../../layouts/Baza.astro';
import SzybkiKontakt from '../../components/SzybkiKontakt.svelte';
import { graf, organizacja, serwis, strona, okruszki } from '../../lib/seo';
import { FIRMA, UBEZPIECZYCIELE } from '../../lib/firma';
import { ZAWODY } from '@ud/zawody';
import { funkcja, TURNSTILE_KLUCZ } from '../../lib/uslugi';

const sciezka = '/pracuj-z-nami/';
const tytul = 'Współpraca dla agentów i sieci sprzedaży | UtrataDochodu.pl';
const opis = 'Ubezpieczenie utraty dochodu jako uzupełnienie polisy na życie. '
  + 'Dedykowane linki sprzedażowe, proces w całości online, prowizja od zawartej polisy.';

const URL_FUNKCJI = funkcja('contact-submit');
const KLUCZ_TURNSTILE = TURNSTILE_KLUCZ;

const ARGUMENTY = [
  {
    tytul: 'Uzupełnienie, nie konkurencja',
    opis: 'Polisa na życie chroni rodzinę na wypadek śmierci. Ubezpieczenie utraty '
      + 'dochodu ratuje budżet firmy klienta przy dłuższej chorobie. Te produkty nie '
      + 'kanibalizują się nawzajem — rozwiązują dwa różne problemy tego samego klienta.',
  },
  {
    tytul: 'Zaplecze, którego nie zbudujesz sam',
    opis: `Pracujemy z ${UBEZPIECZYCIELE.join(' i ')}. Ocena ryzyka zawodowego dla `
      + `${ZAWODY.length} grup, warianty medyczne z klauzulami HIV/WZW i underwriting `
      + 'przy wysokich sumach — to jest wiedza, którą wnosimy do wspólnego klienta.',
  },
  {
    tytul: 'Proces w całości online',
    opis: 'Dostajesz dedykowany link sprzedażowy. Klient sam wypełnia wniosek, my '
      + 'prowadzimy sprawę do wystawienia polisy, Ty rozliczasz prowizję. Bez '
      + 'papierologii po Twojej stronie.',
  },
  {
    tytul: 'Autorski system porównywania ofert',
    opis: 'Wniosek klienta trafia do naszego systemu, który zestawia warianty obu '
      + 'ubezpieczycieli obok siebie: sumy, składki, okres wypłaty i wyłączenia. '
      + 'Zamiast czytać dwa komplety OWU, widzisz jedną tabelę i wiesz, gdzie '
      + 'przebiega różnica. Do klienta idzie gotowa oferta w PDF z Twoimi danymi, '
      + 'a komplet dokumentów — OWU i karty produktu — dopina się do niej sam.',
    obraz: '/img/system-ofert.png',
    obrazOpis: 'Zestawienie wariantów ofert w panelu — sumy, składki i okres wypłaty obok siebie.',
  },
];

/** Zrzut z panelu pokazujemy tylko, gdy plik faktycznie leży w repozytorium. */
import { existsSync } from 'node:fs';
const maZrzut = (sciezka: string) => existsSync(new URL(`../../../public${sciezka}`, import.meta.url));

const sciezkaOkruszkow = [
  { nazwa: 'Strona główna', url: '/' },
  { nazwa: 'Pracuj z nami', url: sciezka },
];

const jsonld = graf([
  organizacja(),
  serwis(),
  okruszki(sciezkaOkruszkow),
  strona({ url: sciezka, tytul, opis, okruszki: sciezkaOkruszkow }),
]);
---
<Baza tytul={tytul} opis={opis} sciezka={sciezka} jsonld={jsonld}>
  <div class="bg-linear-102 from-tlo via-tlo-cyjan to-tlo-hero border-b border-linia">
    <div class="max-w-[1200px] mx-auto px-5 py-16">
      <nav aria-label="Okruszki" class="mb-5">
        <ol class="flex flex-wrap gap-2 text-[13px] text-tekst-trzeci list-none m-0 p-0">
          <li><a href="/" class="hover:text-akcent-ciemny">Strona główna</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-tekst-drugi">Pracuj z nami</li>
        </ol>
      </nav>
      <p class="font-mono text-xs tracking-[0.16em] uppercase text-akcent-ciemny font-semibold m-0">
        Dla agentów i sieci sprzedaży
      </p>
      <h1 class="mt-4 mb-5 text-[clamp(2rem,5vw,2.9rem)] leading-[1.07] max-w-[16em]">
        Twoi klienci B2B potrzebują czegoś więcej niż polisy na życie
      </h1>
      <p data-odpowiedz class="text-[1.12rem] leading-relaxed text-tekst-drugi max-w-[42em] m-0">
        Specjalista na kontrakcie ma zabezpieczoną rodzinę i niezabezpieczoną firmę.
        Ubezpieczenie utraty dochodu zamyka tę lukę, a Ty dokładasz je do teczki bez
        budowania własnego zaplecza produktowego.
      </p>
    </div>
  </div>

  <section class="max-w-[1200px] mx-auto px-5 py-16">
    <div class="grid gap-6 grid-cols-[repeat(auto-fit,minmax(19rem,1fr))]">
      {ARGUMENTY.map((a, i) => (
        <article class:list={['border border-linia bg-tlo flex flex-col',
                              'obraz' in a && 'sm:col-span-2 lg:col-span-3']}>
          <div class="p-7">
            <span class="font-mono text-[1.7rem] leading-none text-akcent" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h2 class="text-[19px] font-semibold mt-4 mb-3 leading-snug">{a.tytul}</h2>
            <p class="text-[15.5px] leading-relaxed text-tekst-drugi m-0 max-w-[46em]">{a.opis}</p>
          </div>
          {'obraz' in a && a.obraz && maZrzut(a.obraz) && (
            <figure class="m-0 border-t border-linia bg-tlo-jasne p-5 sm:p-7">
              <img src={a.obraz} alt={a.obrazOpis} loading="lazy" decoding="async"
                   class="w-full h-auto border border-linia">
              <figcaption class="text-[13px] leading-relaxed text-tekst-trzeci mt-3">
                {a.obrazOpis}
              </figcaption>
            </figure>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="bg-tlo-jasne border-y border-linia">
    <div class="max-w-[1200px] mx-auto px-5 py-16 grid gap-12 lg:grid-cols-[1fr_26rem] items-start">
      <div>
        <h2 class="text-[clamp(1.5rem,3.5vw,2.1rem)] leading-tight mt-0 mb-3">Zacznijmy współpracę</h2>
        <p class="text-[16px] leading-relaxed text-tekst-drugi mt-0 mb-4 max-w-[36em]">
          Zostaw kontakt, a menedżer ds. współpracy opowie o warunkach prowizyjnych
          i zasadach partnerstwa. Powiedz mu przy rozmowie, jaką sieć reprezentujesz —
          od tego zależy, jak ułożymy przekazywanie klientów.
        </p>
        <p class="text-[15px] leading-relaxed text-tekst-drugi mt-0 mb-0 max-w-[36em]">
          Wolisz napisać? <a href={`mailto:${FIRMA.email}`} class="text-akcent-hover underline decoration-linia-mocna underline-offset-2">{FIRMA.email}</a>
        </p>
      </div>
      <div class="border border-linia bg-tlo p-7">
        <SzybkiKontakt client:visible urlFunkcji={URL_FUNKCJI} kluczTurnstile={KLUCZ_TURNSTILE}
                       etykietaPrzycisku="Wyślij zgłoszenie" />
      </div>
    </div>
  </section>
</Baza>
