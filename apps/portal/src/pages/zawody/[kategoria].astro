---
import { kategorie, wKategorii, tresc, liczebnik } from '@ud/zawody';
import Baza from '../../layouts/Baza.astro';
import { graf, organizacja, serwis, strona, okruszki } from '../../lib/seo';
import { Image } from 'astro:assets';
import { obrazKategorii, opisIlustracji } from '../../lib/obrazy';

export function getStaticPaths() {
  return kategorie().map((k) => ({ params: { kategoria: k.slug }, props: { kategoria: k } }));
}

const { kategoria } = Astro.props;
const zawodyKategorii = wKategorii(kategoria.nazwa);

const sciezka = `/zawody/${kategoria.slug}/`;
const ileZawodow = liczebnik(kategoria.liczba, ['zawód', 'zawody', 'zawodów']);
const tytul = `Ubezpieczenie utraty dochodu — ${kategoria.nazwa} | UtrataDochodu.pl`;
/**
 * Nazwa grupy zostaje w oryginalnej pisowni: „IT / Tech" po toLowerCase()
 * dawało „z branży it / tech". Do 21.10.2026 opis twierdził też, że polisa
 * „podnosi" zasiłek ZUS — nie podnosi, wypłaca osobne świadczenie.
 */
const opis = `${kategoria.nazwa}: ${ileZawodow}, każdy z osobną stroną — ryzyka zawodowe, `
  + 'zasiłek ZUS na zwolnieniu i symulacja składki. Polisa wypłaca co miesiąc do 80% '
  + 'udokumentowanego dochodu na B2B.';

/**
 * Na kafelku — pierwsze ryzyko z opisu zawodu. Stało tu „świadczenie do 500 zł
 * / dzień" ze starego serwisu: limitu dziennego w ofercie nie ma, liczba nie
 * miała pokrycia. Ryzyko jest prawdziwe i różni kafelki między sobą.
 */
const ryzykoNaKafelku = (z: (typeof zawodyKategorii)[number]) =>
  (tresc(z.slug)?.ryzyka ?? z.ryzyka)[0]?.tytul ?? null;

const sciezkaOkruszkow = [
  { nazwa: 'Strona główna', url: '/' },
  { nazwa: 'Zawody', url: '/zawody/' },
  { nazwa: kategoria.nazwa, url: sciezka },
];

const jsonld = graf([
  organizacja(),
  serwis(),
  okruszki(sciezkaOkruszkow),
  strona({ url: sciezka, tytul, opis, okruszki: sciezkaOkruszkow }),
  {
    '@type': 'ItemList',
    '@id': `https://utratadochodu.pl${sciezka}#lista`,
    numberOfItems: zawodyKategorii.length,
    itemListElement: zawodyKategorii.map((z, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: z.nazwa,
      url: `https://utratadochodu.pl/${z.slug}/`,
    })),
  },
]);
---
<Baza tytul={tytul} opis={opis} sciezka={sciezka} jsonld={jsonld}>
  <nav aria-label="Okruszki" class="bg-tlo-jasne border-b border-linia-lekka">
    <ol class="max-w-[1200px] mx-auto px-5 py-3 flex flex-wrap gap-2 items-center text-[13px] text-tekst-trzeci list-none m-0">
      {sciezkaOkruszkow.map((k, i) => (
        <li class="flex gap-2 items-center">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i === sciezkaOkruszkow.length - 1
            ? <span class="text-tekst font-semibold" aria-current="page">{k.nazwa}</span>
            : <a href={k.url} class="hover:text-akcent-ciemny">{k.nazwa}</a>}
        </li>
      ))}
    </ol>
  </nav>

  <!-- Tekst na zdjęciu — powód w komentarzu przy `.zaslona-hero`. -->
  <div class="relative isolate border-b border-linia bg-linear-102 from-tlo via-tlo-cyjan to-tlo-hero">
    {obrazKategorii(kategoria.slug) && (
      <>
        <Image src={obrazKategorii(kategoria.slug)!} alt={opisIlustracji(kategoria.nazwa)}
               widths={[768, 1280, 1920]} sizes="100vw"
               loading="eager" fetchpriority="high"
               class="absolute inset-0 -z-10 w-full h-full object-cover object-[50%_25%]" />
        <div class="absolute inset-0 -z-10 zaslona-hero" aria-hidden="true"></div>
      </>
    )}
    <div class={`max-w-[1200px] mx-auto px-5 flex flex-col justify-end ${obrazKategorii(kategoria.slug)
      ? 'pt-[17rem] pb-16 lg:pt-24 lg:pb-24 min-h-[clamp(22rem,26vw,30rem)]'
      : 'py-16 lg:py-20'}`}>
      <p class="font-mono text-xs tracking-[0.16em] uppercase text-akcent-tekst font-semibold m-0">
        {ileZawodow} w tej branży
      </p>
      <h1 class="mt-4 text-[clamp(2rem,5vw,3rem)] leading-[1.06] mb-5 max-w-[18em]">
        Ubezpieczenie utraty dochodu — {kategoria.nazwa}
      </h1>
      <p data-odpowiedz class="text-[1.12rem] leading-relaxed text-tekst-drugi max-w-[38em] m-0">{opis}</p>
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-5 py-16">

    <ul class="grid gap-4 list-none m-0 p-0 grid-cols-[repeat(auto-fill,minmax(17rem,1fr))]">
      {zawodyKategorii.map((z) => (
        <li>
          <a href={`/${z.slug}/`}
             class="block border border-linia bg-tlo p-5 h-full hover:border-akcent hover:bg-tlo-jasne">
            <span class="block font-semibold text-[16.5px] mb-1">{z.nazwa}</span>
            {ryzykoNaKafelku(z) && (
              <span class="block text-[13.5px] text-tekst-drugi">
                <span class="sr-only">{' — '}</span>{ryzykoNaKafelku(z)}
              </span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Baza>
