---
/**
 * Opinie klientów.
 *
 * 21.10.2026 zdjęte obie opublikowane opinie: właściciel potwierdził, że nie
 * pochodziły od klientów. Strona twierdziła przy tym, że „wszystkie opinie
 * publikujemy po weryfikacji" i że „każda przechodzi weryfikację" — a jedyną
 * weryfikacją był Turnstile, który odsiewa boty, nie sprawdza, czy autor ma
 * polisę. Opinia konsumencka pokazana jako opinia klienta, choć nikt tego nie
 * sprawdził, to nieuczciwa praktyka rynkowa.
 *
 * Dlatego strona pokazuje WYŁĄCZNIE opinie z polem `potwierdzonoKlienta`
 * (data, ISO), wpisywanym ręcznie po sprawdzeniu, że autor zawarł polisę za
 * naszym pośrednictwem. `scripts/synchronizuj.mjs` tego pola nie zna
 * i przepisuje do opinie.json wszystko z `ud_review.approved = true` — także
 * te dwie zdjęte — więc bez tego filtra pełna synchronizacja opublikowałaby je
 * z powrotem po cichu. Pilnuje tego test/podmioty.spec.js.
 *
 * Świadomie bez znacznika AggregateRating ani Review. Google nie dopuszcza do
 * wyników rozszerzonych ocen, które firma zbiera sama o sobie („self-serving
 * reviews"). Opinie zostają zwykłą treścią strony.
 */
import Baza from '../../layouts/Baza.astro';
import Opinia from '../../components/Opinia.svelte';
import { graf, organizacja, serwis, strona, okruszki } from '../../lib/seo';
import dane from '../../dane/opinie.json';
import { funkcja, TURNSTILE_KLUCZ } from '../../lib/uslugi';

const sciezka = '/opinie/';
const tytul = 'Opinie klientów | UtrataDochodu.pl';

const URL_FUNKCJI = funkcja('review-submit');
const KLUCZ_TURNSTILE = TURNSTILE_KLUCZ;

type Opinia = {
  imie: string;
  miasto: string;
  zawod?: string | null;
  ocena: number;
  tresc: string;
  data: string;
  /** Data (ISO) sprawdzenia, że autor jest naszym klientem. Bez niej opinii nie pokazujemy. */
  potwierdzonoKlienta?: string;
};
const OPINIE = (dane.opinie as Opinia[]).filter((o) => Boolean(o.potwierdzonoKlienta));
/** Opis w wynikach wyszukiwania nie może obiecywać opinii, których na stronie nie ma. */
const opis = OPINIE.length === 0
  ? 'Zbieramy pierwsze opinie klientów UtrataDochodu.pl. Publikujemy wyłącznie opinie osób, '
    + 'które zawarły polisę za naszym pośrednictwem — także krytyczne.'
  : 'Opinie osób, które zawarły polisę przez UtrataDochodu.pl. Publikujemy je '
    + 'po potwierdzeniu, że autor jest naszym klientem — także krytyczne.';
const data = (iso: string) =>
  new Date(iso).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });

const sciezkaOkruszkow = [
  { nazwa: 'Strona główna', url: '/' },
  { nazwa: 'Opinie', url: sciezka },
];

const jsonld = graf([
  organizacja(),
  serwis(),
  okruszki(sciezkaOkruszkow),
  strona({ url: sciezka, tytul, opis, okruszki: sciezkaOkruszkow }),
]);
---
<Baza tytul={tytul} opis={opis} sciezka={sciezka} jsonld={jsonld}>
  <div class="bg-tlo-jasne border-b border-linia">
    <div class="max-w-[1200px] mx-auto px-5 py-14">
      <nav aria-label="Okruszki" class="mb-5">
        <ol class="flex flex-wrap gap-2 text-[13px] text-tekst-trzeci list-none m-0 p-0">
          <li><a href="/" class="hover:text-akcent-ciemny">Strona główna</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-tekst-drugi">Opinie</li>
        </ol>
      </nav>
      <h1 class="text-[clamp(2rem,5vw,2.9rem)] leading-[1.08] m-0">Opinie klientów</h1>
      <p data-odpowiedz class="text-[1.12rem] leading-relaxed text-tekst-drugi max-w-[40em] mt-5 mb-0">
        {OPINIE.length === 0
          ? 'Zbieramy pierwsze opinie. Jeśli masz u nas polisę, napisz, jak poszło.'
          : `Opinie potwierdzonych klientów: ${OPINIE.length}.`}
        {' '}Opinię publikujemy dopiero wtedy, gdy potwierdzimy, że autor zawarł polisę
        za naszym pośrednictwem — także wtedy, gdy jest krytyczna.
      </p>
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-5 py-14 grid gap-14 lg:grid-cols-[1fr_28rem] items-start">
    <section aria-labelledby="lista">
      <h2 id="lista" class="sr-only">Lista opinii</h2>
      {OPINIE.length === 0 ? (
        <p class="border border-dashed border-linia-mocna p-8 text-[15.5px] text-tekst-trzeci text-center m-0">
          Nie mamy jeszcze opublikowanych opinii.
        </p>
      ) : (
        <ul class="list-none m-0 p-0 grid gap-5 grid-cols-[repeat(auto-fill,minmax(20rem,1fr))]">
          {OPINIE.map((o) => (
            <li class="border border-linia bg-tlo p-6 flex flex-col">
              <p class="m-0 mb-3 text-[1.3rem] leading-none tracking-[0.08em]">
                <span class="text-akcent" aria-hidden="true">{'★'.repeat(o.ocena)}</span><span
                      class="text-linia-mocna" aria-hidden="true">{'★'.repeat(5 - o.ocena)}</span>
                <span class="sr-only">Ocena {o.ocena} na 5</span>
              </p>
              <blockquote class="m-0 flex-grow">
                <p class="text-[15.5px] leading-relaxed text-tekst-drugi m-0">{o.tresc}</p>
              </blockquote>
              <footer class="flex flex-wrap gap-x-3 gap-y-1 justify-between items-baseline
                             pt-4 mt-5 border-t border-linia text-[13px] text-tekst-trzeci">
                <span class="font-semibold text-[14px] text-tekst">
                  {o.imie}{o.zawod ? <span class="font-normal text-tekst-drugi">, {o.zawod}</span> : null}
                </span>
                <span>{o.miasto} · <time datetime={o.data}>{data(o.data)}</time></span>
              </footer>
            </li>
          ))}
        </ul>
      )}
    </section>

    <aside class="border border-linia bg-tlo-jasne p-7">
      <h2 class="text-[20px] font-semibold mt-0 mb-2">Masz u nas polisę?</h2>
      <p class="text-[15px] leading-relaxed text-tekst-drugi mt-0 mb-6">
        Napisz, jak wyglądała obsługa. Opinia pojawi się tutaj, gdy potwierdzimy,
        że jesteś naszym klientem — także wtedy, gdy jest krytyczna. Formularz
        jest zabezpieczony przed botami.
      </p>
      <Opinia client:visible urlFunkcji={URL_FUNKCJI} kluczTurnstile={KLUCZ_TURNSTILE} />
    </aside>
  </div>
  <!-- Bez tego skryptu widżet się nie montuje, token idzie pusty, a funkcja
       odpowiada 400 — od 14.10.2026 do 21.10.2026 ten formularz nie wysłał
       ani jednego zgłoszenia. render=explicit, bo komponent sam tworzy widżet
       (zamontuj() w onMount albo onloadTurnstileCallback). -->
  <script is:inline async defer
          src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onloadTurnstileCallback"></script>
</Baza>
