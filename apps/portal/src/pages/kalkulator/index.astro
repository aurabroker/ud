---
import Baza from '../../layouts/Baza.astro';
import Kalkulator from '../../components/Kalkulator.svelte';
import { graf, organizacja, serwis, strona, okruszki, faq } from '../../lib/seo';
import { symuluj, zl, zlZakres, LIMIT, LIMIT_CEU_ZDANIE, MIESIECY_WYPLATY, MIESIECY_MAX, OKRESY, ZAKRES_DOCHODU, STAWKA } from '../../lib/symulacja';
import { SWIADCZENIE_MAX } from '../../lib/granice';
import { ZASILEK_JDG, ZUS_TEKST, WYCZEKIWANIE_DOBROWOLNE_DNI, OKRES_ZASILKOWY_DNI } from '../../lib/zus';
import { PRZYKLAD, OPROCENTOWANIE, miesiaceDoKwoty, czasSlownie } from '../../lib/odkladanie';
import { liczebnik } from '@ud/zawody/liczebnik';

const sciezka = '/kalkulator/';
const tytul = 'Kalkulator ubezpieczenia utraty dochodu | UtrataDochodu.pl';
const opis = 'Policz, ile dostaniesz z ZUS na zwolnieniu, ile wypłaci polisa i ile może kosztować. '
  + `Symulacja dla działalności i kontraktu B2B przy dochodzie od ${zl(ZAKRES_DOCHODU.min)} `
  + `do ${zl(ZAKRES_DOCHODU.max)}.`;

/** Kilka punktów odniesienia w HTML-u — kalkulator jest wyspą, więc bez nich
 *  robot i model językowy zobaczyłyby pustą ramkę. */
const PRZYKLADY = [10000, 18000, 30000, 50000].map((d) => ({
  dochod: d,
  ...symuluj({ dochod: d }),
}));

/** Przykład właściciela do pytania „czy nie lepiej odkładać" — liczby z tego samego rachunku co symulator. */
const ODKLADANIE = {
  ...PRZYKLAD,
  naJeden: czasSlownie(miesiaceDoKwoty(PRZYKLAD.swiadczenie, PRZYKLAD.odkladam, OPROCENTOWANIE)),
  naDwa: czasSlownie(miesiaceDoKwoty(2 * PRZYKLAD.swiadczenie, PRZYKLAD.odkladam, OPROCENTOWANIE)),
  skladkaOd: Math.round(PRZYKLAD.swiadczenie * STAWKA.dol),
  skladkaDo: Math.round(PRZYKLAD.swiadczenie * STAWKA.gora),
};

const PYTANIA = [
  {
    pytanie: 'Czy wynik kalkulatora to oferta?',
    odpowiedz: 'Nie. To symulacja pokazująca rząd wielkości. Realną składkę wylicza '
      + 'system ubezpieczyciela po ocenie ryzyka — zawodu, wieku, sumy ubezpieczenia '
      + 'i ankiety medycznej.',
  },
  {
    pytanie: 'Skąd bierze się kwota zasiłku z ZUS w kalkulatorze?',
    odpowiedz: `Zasiłek chorobowy to ${ZUS_TEKST.wzor}. Kalkulator pokazuje go ${ZUS_TEKST.scenariusz}: `
      + `${zl(ZASILEK_JDG.duzy)} miesięcznie, przed podatkiem. Dla porównania: ${ZUS_TEKST.dopiski}. `
      + `Zasiłek przysługuje najdłużej przez ${OKRES_ZASILKOWY_DNI} dni, a przedsiębiorcy po `
      + `${WYCZEKIWANIE_DOBROWOLNE_DNI} dniach nieprzerwanego ubezpieczenia chorobowego; wlicza się `
      + 'wcześniejsze ubezpieczenie chorobowe, np. z etatu, jeśli przerwa nie przekroczyła 30 dni. '
      + 'Jeśli opłacasz składki od wyższej podstawy, Twój zasiłek będzie wyższy.',
  },
  {
    pytanie: 'Czy kalkulator liczy też umowę o pracę?',
    odpowiedz: `Nie — tylko działalność i kontrakt B2B. ${ZUS_TEKST.etat} Na etacie polisa `
      + `obejmuje do ${Math.round(LIMIT.etat * 100)}% dochodu, a składkę wylicza ubezpieczyciel `
      + 'na podstawie wniosku.',
  },
  {
    pytanie: 'Jak długo wypłacane jest świadczenie?',
    odpowiedz: `Do wyboru są cztery okresy: ${OKRESY.join(', ')} miesięcy. To najdłuższy czas `
      + 'wypłaty, wybierany przy zawarciu umowy: świadczenie przychodzi co miesiąc, dopóki trwa '
      + 'orzeczona niezdolność do wykonywania zawodu, ale nie dłużej niż wybrany okres. '
      + 'Pierwsza wypłata przysługuje po okresie wyczekiwania ustalonym w umowie. Kalkulator '
      + `liczy składkę dla wariantu najkrótszego, ${MIESIECY_WYPLATY}-miesięcznego — dłuższy `
      + 'okres wypłaty ją podnosi.',
  },
  {
    pytanie: 'Dlaczego świadczenie nie może pokryć 100% dochodu?',
    odpowiedz: `Limit wynosi do ${Math.round(LIMIT.b2b * 100)}% przy samozatrudnieniu i kontrakcie B2B `
      + `oraz do ${Math.round(LIMIT.etat * 100)}% przy umowie o pracę, a świadczenie miesięczne `
      + `wynosi najwyżej ${zl(SWIADCZENIE_MAX)}. ${LIMIT_CEU_ZDANIE} Zasada jest taka, że `
      + 'ubezpieczenie nie może być korzystniejsze finansowo niż praca.',
  },
  {
    pytanie: 'Czy nie lepiej odkładać co miesiąc zamiast płacić składkę?',
    odpowiedz: `Odkładając ${zl(ODKLADANIE.odkladam)} miesięcznie, równowartość jednego miesiąca `
      + `świadczenia ${zl(ODKLADANIE.swiadczenie)} zbierasz ${ODKLADANIE.naJeden}, a dwóch — `
      + `${ODKLADANIE.naDwa} (przy oprocentowaniu ${OPROCENTOWANIE}% rocznie). Polisa z takim świadczeniem `
      + `kosztuje szacunkowo ${zlZakres(ODKLADANIE.skladkaOd, ODKLADANIE.skladkaDo)} miesięcznie, razem z opłatą `
      + `dystrybucyjną, w wariancie z wypłatą najdłużej przez `
      + `${liczebnik(MIESIECY_WYPLATY, ['miesiąc', 'miesiące', 'miesięcy'])} — to `
      + 'symulacja z ostatnio wystawionych ofert, nie oferta. Świadczenie przychodzi co miesiąc po '
      + 'okresie wyczekiwania, dopóki trwa niezdolność objęta umową; dłuższy okres wypłaty, do '
      + `${MIESIECY_MAX} miesięcy, podnosi składkę. Odłożone pieniądze zostają jednak Twoje, a składka `
      + 'nie wraca, jeśli nic się nie stanie. Kalkulator na tej stronie liczy to obok składki, '
      + 'dla Twojego dochodu.',
  },
];

const sciezkaOkruszkow = [
  { nazwa: 'Strona główna', url: '/' },
  { nazwa: 'Kalkulator', url: sciezka },
];

const jsonld = graf([
  organizacja(),
  serwis(),
  okruszki(sciezkaOkruszkow),
  strona({ url: sciezka, tytul, opis, okruszki: sciezkaOkruszkow }),
  faq(PYTANIA, sciezka),
]);
---
<Baza tytul={tytul} opis={opis} sciezka={sciezka} jsonld={jsonld}>
  <div class="bg-linear-102 from-tlo via-tlo-cyjan to-tlo-hero border-b border-linia">
    <!-- Tekst 1/3, karta kalkulatora z odkładaniem 2/3 (decyzja właściciela z 23.10.2026):
         wynik odkładania stoi obok składki, zamiast w osobnej sekcji na dole strony.
         Obok siebie od 1280 px — przy 1024 px karta na 2/3 dawała kolumny po 290 px
         i wyniki łamały się na dwie linie; węższe okno stawia tekst nad kartą. -->
    <div class="max-w-[1200px] mx-auto px-5 py-14 lg:py-16 grid gap-10 xl:gap-12 xl:grid-cols-[1fr_2fr] items-start">
      <div>
        <nav aria-label="Okruszki" class="mb-5">
          <ol class="flex flex-wrap gap-2 text-[13px] text-tekst-trzeci list-none m-0 p-0">
            <li><a href="/" class="hover:text-akcent-ciemny">Strona główna</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-tekst-drugi">Kalkulator</li>
          </ol>
        </nav>
        <h1 class="text-[clamp(2rem,5vw,2.6rem)] leading-[1.07] max-w-[15em] m-0">
          Kalkulator ubezpieczenia utraty dochodu
        </h1>
        <p data-odpowiedz class="text-[1.12rem] leading-relaxed text-tekst-drugi max-w-[38em] mt-5 mb-0">
          Podaj miesięczny dochód z działalności albo kontraktu B2B. Zobaczysz, ile
          wypłaci ZUS na zwolnieniu, ile wypłacałaby polisa i ile może kosztować.
          To symulacja poglądowa, nie oferta.
        </p>
      </div>
      <div class="w-full">
        <Kalkulator client:idle zOdkladaniem />
      </div>
    </div>
  </div>

  <section class="max-w-[1200px] mx-auto px-5 py-16">
    <h2 class="text-[clamp(1.5rem,3.5vw,2.2rem)] leading-tight mb-3">Punkty odniesienia</h2>
    <p class="text-[1.05rem] leading-relaxed text-tekst-drugi max-w-[42em] mt-0 mb-8">
      Cztery przykłady dla działalności i kontraktu B2B, policzone tą samą formułą,
      co kalkulator obok. Zasiłek z ZUS nie rośnie razem z dochodem — liczy się
      od zadeklarowanej podstawy składek.
    </p>

    <div class="border border-linia overflow-x-auto">
      <table class="w-full border-collapse text-left min-w-[42rem]">
        <caption class="sr-only">Miesięczny zasiłek z ZUS, świadczenie z polisy i składka przy różnych poziomach dochodu, działalność i kontrakt B2B</caption>
        <thead>
          <tr class="bg-tlo-jasne border-b border-linia-mocna">
            <th scope="col" class="font-mono text-[11px] tracking-[0.11em] uppercase font-semibold text-tekst-drugi px-5 py-4">Dochód netto</th>
            <th scope="col" class="font-mono text-[11px] tracking-[0.11em] uppercase font-semibold text-alarm px-5 py-4">Zasiłek ZUS</th>
            <th scope="col" class="font-mono text-[11px] tracking-[0.11em] uppercase font-semibold text-akcent-ciemny px-5 py-4">Świadczenie z polisy</th>
            <th scope="col" class="font-mono text-[11px] tracking-[0.11em] uppercase font-semibold text-tekst-drugi px-5 py-4">Składka miesięczna</th>
          </tr>
        </thead>
        <tbody>
          {PRZYKLADY.map((p) => (
            <tr class="border-b border-linia last:border-0">
              <th scope="row" class="px-5 py-4 font-semibold text-[15.5px] whitespace-nowrap">{zl(p.dochod)}</th>
              <td class="px-5 py-4 font-mono text-[15.5px] text-alarm whitespace-nowrap">{zl(ZASILEK_JDG.duzy)}</td>
              <td class="px-5 py-4 font-mono text-[15.5px] font-semibold text-akcent-ciemny whitespace-nowrap">{zl(p.swiadczenie)}</td>
              <td class="px-5 py-4 font-mono text-[15.5px] whitespace-nowrap">{zlZakres(p.skladkaOd, p.skladkaDo)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-[13px] leading-relaxed text-tekst-drugi mt-4 mb-0 max-w-[46em]">
      Założenia: zasiłek to {ZUS_TEKST.wzor}, {ZUS_TEKST.scenariusz}; {ZUS_TEKST.dopiski}.{' '}
      {ZUS_TEKST.brutto} Świadczenie z polisy to {Math.round(LIMIT.b2b * 100)}% dochodu,
      wypłacane co miesiąc najdłużej przez {MIESIECY_MAX} miesięcy, zależnie od wariantu. Składka
      dotyczy wariantu z wypłatą do {MIESIECY_WYPLATY} miesięcy, razem z opłatą dystrybucyjną, jako
      przedział z ostatnio wystawionych ofert. Symulacja, nie oferta.
    </p>
  </section>

  <section class="bg-tlo-jasne border-y border-linia">
    <div class="max-w-[1200px] mx-auto px-5 py-14">
      <h2 class="text-[clamp(1.5rem,3.5vw,2.1rem)] leading-tight mb-8">Jak czytać ten wynik</h2>
      <div class="border-t border-linia max-w-[52em]">
        {PYTANIA.map((p, i) => (
          <details class="border-b border-linia group" open={i < 2}>
            <summary class="cursor-pointer list-none py-5 flex gap-4 items-start justify-between font-semibold text-[17px]">
              {p.pytanie}
              <span aria-hidden="true" class="text-akcent-ciemny shrink-0 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="text-[16px] leading-relaxed text-tekst-drugi pb-5 mt-0 max-w-[46em]">{p.odpowiedz}</p>
          </details>
        ))}
      </div>
      <div class="flex flex-wrap gap-3 mt-9">
        <a href="/wniosek/" class="bg-akcent-ciemny text-white px-8 py-4 font-bold hover:bg-akcent-hover">
          Policz realną składkę we wniosku
        </a>
        <a href="/wylaczenia/" class="border-[1.5px] border-akcent text-akcent-ciemny bg-tlo px-8 py-[14px] font-semibold hover:bg-tlo-jasne">
          Zobacz wyłączenia
        </a>
      </div>
    </div>
  </section>
</Baza>
