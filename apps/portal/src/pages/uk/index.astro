---
/**
 * Strona główna po ukraińsku.
 *
 * Trzy warstwy treści, każda z innym źródłem:
 *
 * 1. Przekład strony głównej (`src/pages/index.astro`) — zdanie w zdanie.
 *    Kwoty, limity i okresy nie są przepisane: idą z `symulacja.ts`, tak jak
 *    po polsku. Zmieniasz polskie pytanie — zmień jego odpowiednik tutaj.
 * 2. Sekcja „Якщо ви з України" — jedyna treść, której strona polska nie ma.
 *    Każde zdanie ma tam w komentarzu źródło: paragraf OWU, pole formularza
 *    albo przepis. Nie dopisuj zdania bez źródła — to strona o tym, co polisa
 *    obejmie, a czego nie, czytana przez ludzi w obcym dla nich systemie.
 * 3. Informacja o języku: wniosek, umowa i OWU są po polsku i strona mówi to
 *    wprost, zanim klient zacznie cokolwiek wypełniać.
 */
import Baza from '../../layouts/Baza.astro';
import Kalkulator from '../../components/Kalkulator.svelte';
import { ZAWODY } from '@ud/zawody';
import { ZAWODY_UK } from '../../dane/uk/zawody';
import { symuluj, zl, zlZakres, LIMIT, MIESIECY_MAX } from '../../lib/symulacja';
import { SWIADCZENIE_MAX } from '../../lib/granice';
import { ZASILEK_JDG, WYCZEKIWANIE_DOBROWOLNE_DNI } from '../../lib/zus';
import { graf, organizacja, serwis, strona, faq } from '../../lib/seo';
import { FIRMA, COVERHOLDERZY } from '../../lib/firma';
import { Image } from 'astro:assets';
import { obrazHero, zdjecieZawodu } from '../../lib/obrazy';
import { zawod, slugKategorii } from '@ud/zawody';
import { GRANICE_WIEKU, ZUS_TEKST_UK, LIMIT_CEU_ZDANIE_UK, liczebnikUk } from '../../lib/uk';

const sciezka = '/uk/';
const tytul = 'Страхування від втрати доходу в Польщі для JDG і B2B | UtrataDochodu.pl';
const b2b = Math.round(LIMIT.b2b * 100);
const etat = Math.round(LIMIT.etat * 100);

const opis = `Приватний лікарняний для B2B і фахівців на контракті в Польщі. Поліс щомісяця виплачує до ${b2b}% `
  + 'доходу, тоді як ZUS рахує допомогу від задекларованої бази внесків, а не від того, що ви заробляєте.';

const PYTANIA = [
  {
    pytanie: 'Що таке страхування від втрати доходу?',
    odpowiedz: 'Це поліс, який виплачує щомісячну суму, коли хвороба або нещасний випадок не дають '
      + 'змоги працювати за професією. Виплату розраховують від підтвердженого документами доходу, '
      + 'а не від бази внесків ZUS.',
  },
  {
    pytanie: 'Скільки становить допомога по хворобі від ZUS на контракті B2B?',
    odpowiedz: `Допомога по хворобі (zasiłek chorobowy) — це ${ZUS_TEKST_UK.wzor}. На повному ZUS `
      + '(duży ZUS) з найнижчою базою і з добровільним страхуванням на випадок хвороби це '
      + `${zl(ZASILEK_JDG.duzy)} на місяць до оподаткування, незалежно від того, скільки ви насправді `
      + `заробляєте; ${ZUS_TEKST_UK.dopiski}.`,
  },
  {
    pytanie: 'Який відсоток доходу покриває поліс?',
    odpowiedz: `До ${b2b}% підтвердженого доходу за самозайнятості та контракту B2B, до ${etat}% — за `
      + `трудового договору (umowa o pracę), щонайбільше ${zl(SWIADCZENIE_MAX)} на місяць. `
      + `${LIMIT_CEU_ZDANIE_UK} Ліміт випливає з принципу, що страхування не може бути вигіднішим `
      + 'за роботу.',
  },
  {
    pytanie: 'Відколи починається виплата?',
    odpowiedz: 'Після завершення періоду очікування (okres wyczekiwania), визначеного в договорі '
      + 'й відлічуваного від початку непрацездатності. Далі щомісяця, доки триває непрацездатність, '
      + `щонайдовше протягом ${MIESIECY_MAX} місяців — залежно від періоду, обраного в договорі.`,
  },
  {
    pytanie: 'Чого поліс не покриває?',
    odpowiedz: 'Професійного вигорання як самостійного діагнозу, психічних захворювань, коли вони '
      + 'є єдиною причиною непрацездатності (у CEU — також без цієї умови), часткової '
      + 'непрацездатності та захворювань, які лікували протягом 24 місяців до укладення договору.',
  },
  {
    pytanie: 'Чи потрібні медичні обстеження?',
    odpowiedz: 'За стандартних сум достатньо медичної анкети в заявці. Якщо сума на випадок постійної '
      + 'непрацездатності перевищує мільйон злотих, страховик вимагає розширеної анкети про стан здоров’я.',
  },
];

/**
 * Treść tylko dla wersji ukraińskiej. Źródła — przy każdej pozycji.
 *
 * Trzy rodzaje źródeł i trzy poziomy pewności:
 *  - treść polskich stron sprawdzona z OWU (lista wyłączeń z paragrafami,
 *    `packages/zawody/data/tresci.json`) — tłumaczymy ją tu zdanie w zdanie;
 *  - schemat wniosku i potwierdzenie właściciela;
 *  - dwie pozycje (obywatelstwo i dokumenty CEU) sprawdzone 27.11.2026 z pełnym
 *    tekstem OWU spod /owu/<slug>.pdf — paragrafy przy pozycjach.
 */
const DLA_UKRAINCOW = [
  {
    // Sprawdzone 27.11.2026 z pełnym tekstem sześciu OWU. Leadenhall LW044, LW046 i LW047
    // § 15 ust. 18: „Ubezpieczony oznacza osobę fizyczną określoną w pozycji 3 Polisy";
    // CEU Utrata dochodu § 29 pkt 12 (LOI Premium pkt 11, dla zatrudniających — tak samo):
    // „określoną w Polisie osobę fizyczną objętą ochroną ubezpieczeniową" + warunki co do
    // formy pracy (umowa, kontrakt, JDG). W żadnym z sześciu tekstów nie ma słowa o
    // obywatelstwie, rezydencji ani prawie pobytu; „miejsce zamieszkania" pada tylko przy
    // właściwości sądu i w klauzulach dodatkowych.
    tytul: 'Громадянство',
    opis: 'У загальних умовах страхування (OWU) Leadenhall і CEU немає вимоги польського '
      + 'громадянства: застрахований — це особа, вказана в полісі. Рішення про прийняття на '
      + 'страхування ухвалює страховик після оцінки ризику.',
  },
  {
    // Właściciel, 26.11.2026: „ubezpieczony musi mieć PESEL". Kreator: pole PESEL jest
    // wymagane, pesekPoprawny() i komunikat o wieku w packages/wniosek/src/schemat.js.
    tytul: 'PESEL і вік',
    opis: 'Застрахована особа повинна мати номер PESEL — без нього заявку подати не можна; форма '
      + `перевіряє його контрольну цифру. Захист охоплює осіб віком від ${GRANICE_WIEKU.od} до `
      + `${GRANICE_WIEKU.do} років.`,
  },
  {
    // Formularz, zgody, OWU i obsługa szkody istnieją tylko po polsku.
    tytul: 'Мова документів',
    opis: 'Заявка, згоди, договір, загальні умови страхування (OWU) та розгляд виплати — польською '
      + 'мовою. Ця сторінка лише пояснює їх українською; обов’язковими є польські документи.',
  },
  {
    // zus.ts: WYCZEKIWANIE_DOBROWOLNE_DNI (art. 4 ust. 1 pkt 2 ustawy zasiłkowej). Zdanie
    // o podstawie składek — jak w ZUS_TEKST. Po ukraińsku podaje to gov.pl/web/ua.
    tytul: 'ZUS і JDG',
    opis: 'Страхування на випадок хвороби в ZUS (ubezpieczenie chorobowe) для JDG є добровільним. '
      + `Право на допомогу виникає після ${WYCZEKIWANIE_DOBROWOLNE_DNI} днів безперервного `
      + 'добровільного страхування, а її розмір залежить від бази внесків, а не від доходу.',
  },
  {
    // Dwa zdania z polskich treści sprawdzonych z OWU, zestawione obok siebie:
    //  - „warunki Leadenhall i CEU obejmują ochroną cały świat" — tresci.json, programista,
    //    pytanie o pracę z zagranicy;
    //  - wyłączenie wojny — src/lib/wylaczenia.ts, „Wojna, służba wojskowa…"
    //    (Leadenhall § 11 ust. 1 lit. a–d, CEU Utrata dochodu § 18 pkt 6, 10–12).
    // Strona NIE rozstrzyga, czy konkretne zdarzenie w Ukrainie „wynika z wojny" —
    // to ocenia ubezpieczyciel; stąd rada, żeby zapytać przed wyjazdem.
    tytul: 'Поїздки в Україну',
    opis: 'Умови Leadenhall і CEU охоплюють захистом увесь світ, але виключають війну та воєнні '
      + 'дії, заколот і заворушення масштабу повстання, а також службу у збройних формуваннях. '
      + 'Перед поїздкою зателефонуйте й запитайте, як це стосується вашого поліса.',
  },
  {
    // Pierwsze zdanie: tresci.json, programista („dokumentacja medyczna ma być po polsku
    // (Leadenhall przyjmuje też angielską), a ubezpieczyciel może wezwać na badanie
    // u swojego lekarza"). Język dokumentów sprawdzony 27.11.2026 w pełnym tekście:
    // LW044 — „w języku polskim lub angielskim", CEU — „w języku polskim".
    // Drugie zdanie — CEU Utrata dochodu § 11 ust. 2–3 (LOI Premium § 10 ust. 2–3), pełny
    // tekst: Ubezpieczony „obowiązany jest udokumentować" niezdolność drukiem ZUS ZLA,
    // a bez prawa do ZLA — „zaświadczeniem o stanie zdrowia (…) wystawionym przez lekarza
    // prowadzącego"; ust. 3: samo zaświadczenie „nie będzie wystarczające", komisja lekarska
    // powołana przez ubezpieczyciela może orzec inaczej. Stąd „потрібно задокументувати",
    // nie „підтверджує".
    tytul: 'Документи для виплати',
    opis: 'Під час звернення по виплату медична документація має бути польською (Leadenhall '
      + 'приймає також англійську), тож документи українською потрібно перекласти; страховик може '
      + 'викликати на огляд до свого лікаря. У CEU непрацездатність потрібно задокументувати '
      + 'лікарняним ZUS ZLA, а якщо права на нього немає — довідкою про стан здоров’я від лікаря, '
      + 'який веде лікування. Самої довідки може бути недостатньо: непрацездатність може оцінити '
      + 'лікарська комісія, яку скликає страховик.',
  },
];

const przyklad = symuluj({ dochod: 18000 });

/* Zdania z kwotami składamy tutaj — Astro gubi spację obok {wyrażenia} na końcu linii. */
const lead = 'На B2B допомогу по хворобі від ZUS рахують від задекларованої бази внесків, а не від '
  + `того, що ви реально заробляєте. Поліс щомісяця виплачує до ${b2b}% доходу на B2B і до ${etat}% `
  + 'за трудовим договором.';
const zusWstep = `Допомога по хворобі — це ${ZUS_TEKST_UK.wzor}, а не 80% вашого доходу. За `
  + 'найнижчої бази різниця для фахівця на контракті сягає кільканадцяти тисяч злотих на місяць.';
const zusPrzypis = `Орієнтовний розрахунок, а не пропозиція. Допомога ZUS — ${ZUS_TEKST_UK.scenariusz}; `
  + `${ZUS_TEKST_UK.dopiski}. ${ZUS_TEKST_UK.brutto} Орієнтовний внесок за такої виплати: `
  + `${zlZakres(przyklad.skladkaOd, przyklad.skladkaDo)} на місяць, разом із платою за дистрибуцію (opłata dystrybucyjna). `
  + 'Реальний внесок розраховує система страховика після оцінки ризику.';
// Zdanie kończy się zwykłym słowem: nazwa z „S.A." albo „sp. z o.o." na końcu dałaby dwie kropki.
const podmioty = `Страховиком є ${FIRMA.ubezpieczyciel}, а договір укладають через `
  + `${COVERHOLDERZY.join(' і ')} — ковергольдерів Lloyd’s (coverholders).`;
const grupy = `${liczebnikUk(ZAWODY.length, ['професійна група', 'професійні групи', 'професійних груп'])}, `
  + `для кожної — окремий розрахунок і опис ризику. ${ZAWODY_UK.length} з них описано українською, `
  + 'решту — польською.';

const jsonld = graf([
  organizacja(),
  serwis(),
  strona({ url: sciezka, tytul, opis, jezyk: 'uk' }),
  faq(PYTANIA, sciezka),
]);

const hero = obrazHero();

/** Zdjęcia zawodów te same co po polsku; opis alternatywny po ukraińsku. */
const KAFELKI = ZAWODY_UK.map((z) => {
  const pl = zawod(z.slug)!;
  const zdjecie = zdjecieZawodu(z.slug, pl.odmiana.mianownik, slugKategorii(pl.kategoria), pl.kategoria);
  return { ...z, obraz: zdjecie?.obraz ?? null };
});
---
<Baza tytul={tytul} opis={opis} sciezka={sciezka} jsonld={jsonld} jezyk="uk">
  <div class="relative isolate bg-linear-102 from-tlo via-tlo-cyjan to-tlo-hero border-b border-linia">
    {hero && (
      <>
        <Image src={hero} alt="" widths={[768, 1280, 1920]} sizes="100vw"
               loading="eager" fetchpriority="high"
               class="absolute inset-0 -z-10 w-full h-full object-cover object-[50%_25%]" />
        <div class="absolute inset-0 -z-10 zaslona-hero" aria-hidden="true"></div>
      </>
    )}
    <div class="max-w-[1200px] mx-auto px-5 py-20 lg:py-24 flex flex-col lg:flex-row gap-14 items-start">
      <div class="lg:flex-1 min-w-0">
        <p class="font-mono text-xs tracking-[0.16em] uppercase text-akcent-tekst font-semibold m-0">
          Приватний лікарняний для самозайнятих у Польщі
        </p>
        <h1 class="mt-4 mb-5 text-[clamp(2.2rem,6vw,3.6rem)] leading-[1.05] max-w-[14em]">
          Страхування від втрати доходу
        </h1>
        <p data-odpowiedz class="text-[clamp(1.05rem,2vw,1.2rem)] leading-relaxed text-tekst-drugi max-w-[32em] m-0">
          {lead}
        </p>
        <div class="flex flex-wrap gap-3 mt-9">
          <a href="/uk/wniosek/" class="bg-akcent-ciemny text-white px-8 py-4 font-bold hover:bg-akcent-hover">
            Як подати заявку
          </a>
          <a href="/uk/wylaczenia/" class="border-[1.5px] border-akcent text-akcent-tekst bg-tlo px-8 py-[14px] font-semibold hover:bg-tlo-jasne">
            Що не покривається
          </a>
        </div>
        <ul class="flex flex-wrap gap-x-7 gap-y-2 mt-9 text-[14px] text-tekst-drugi list-none m-0 p-0">
          <li>Не виходячи з дому</li>
          <li>Пропозиція за 1–2 робочі дні</li>
          <li>Варіанти Leadenhall і CEU</li>
        </ul>
        {/* Język obsługi mówimy od razu, przy pierwszym przycisku — nie w stopce. */}
        <p class="text-[14px] leading-relaxed text-tekst-drugi max-w-[34em] mt-6 mb-0">
          Заявка, договір і загальні умови страхування — польською мовою.{' '}
          <a href="/uk/wniosek/" class="text-akcent-tekst underline decoration-linia-mocna underline-offset-2">Пояснюємо кожен крок українською</a>.
        </p>
      </div>

      <div class="w-full lg:w-[26em] shrink-0">
        <Kalkulator client:idle jezyk="uk" />
      </div>
    </div>
  </div>

  <section class="max-w-[1200px] mx-auto px-5 py-16 lg:py-20">
    <h2 class="text-[clamp(1.6rem,4vw,2.5rem)] leading-tight mb-3 max-w-[20em]">
      Скільки ви реально отримаєте від ZUS, якщо захворієте?
    </h2>
    <p data-odpowiedz class="text-[1.12rem] leading-relaxed text-tekst-drugi max-w-[42em] mt-0 mb-9">
      {zusWstep}
    </p>

    <div class="border border-linia overflow-x-auto">
      <table class="w-full border-collapse text-left min-w-[36rem]">
        <caption class="sr-only">Місячна допомога від ZUS і виплата за полісом при доході 18 000 zł на B2B</caption>
        <thead>
          <tr class="bg-tlo-jasne border-b border-linia-mocna">
            <th scope="col" class="font-mono text-[11px] tracking-[0.11em] uppercase font-semibold text-tekst-drugi px-6 py-4">Місяць на лікарняному</th>
            <th scope="col" class="font-mono text-[11px] tracking-[0.11em] uppercase font-semibold text-tekst-drugi px-6 py-4">Допомога ZUS</th>
            <th scope="col" class="font-mono text-[11px] tracking-[0.11em] uppercase font-semibold text-akcent-tekst px-6 py-4">Виплата за полісом</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row" class="px-6 py-5 font-semibold text-[16px]">Дохід {zl(18000)} на B2B, duży ZUS зі страхуванням на випадок хвороби</th>
            <td class="px-6 py-5 font-mono text-xl font-semibold text-alarm">{zl(ZASILEK_JDG.duzy)}</td>
            <td class="px-6 py-5 font-mono text-xl font-semibold text-akcent-ciemny">{zl(przyklad.swiadczenie)}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-[13px] leading-relaxed text-tekst-drugi mt-4 mb-0">{zusPrzypis}</p>
  </section>

  <section class="bg-tlo-jasne border-y border-linia" aria-labelledby="dla-ukraincow">
    <div class="max-w-[1200px] mx-auto px-5 py-16">
      <h2 id="dla-ukraincow" class="text-[clamp(1.6rem,4vw,2.5rem)] leading-tight mb-3 max-w-[22em]">
        Якщо ви з України і працюєте в Польщі
      </h2>
      <p class="text-[1.05rem] leading-relaxed text-tekst-drugi max-w-[42em] mt-0 mb-9">
        Шість речей, які варто знати до подання заявки. {podmioty}
      </p>
      <dl class="grid gap-x-10 gap-y-8 m-0 grid-cols-[repeat(auto-fill,minmax(min(20rem,100%),1fr))]">
        {DLA_UKRAINCOW.map((p) => (
          <div class="border-l-[3px] border-akcent pl-5">
            <dt class="text-[17px] font-semibold mb-2 leading-snug">{p.tytul}</dt>
            <dd class="text-[15px] leading-relaxed text-tekst-drugi m-0">{p.opis}</dd>
          </div>
        ))}
      </dl>
      <p class="text-[14px] leading-relaxed text-tekst-drugi max-w-[46em] mt-9 mb-0">
        Правила допомоги по хворобі для іноземців українською описує офіційна сторінка{' '}
        <a href="https://www.gov.pl/web/ua/Bazovi-vyplaty-na-vypadok-khvoroby" rel="noopener"
           class="text-akcent-tekst underline decoration-linia-mocna underline-offset-2">gov.pl — «Базові виплати на випадок хвороби»</a>.
        Загальні умови страхування —{' '}
        <a href="/dokumenty/" lang="pl" hreflang="pl"
           class="text-akcent-tekst underline decoration-linia-mocna underline-offset-2">OWU i karty produktu</a> (польською).
      </p>
    </div>
  </section>

  <section class="max-w-[1200px] mx-auto px-5 py-16 lg:py-20">
    <h2 class="text-[clamp(1.6rem,4vw,2.5rem)] leading-tight mb-3">Для кого цей поліс</h2>
    <p class="text-[1.05rem] leading-relaxed text-tekst-drugi max-w-[42em] mt-0 mb-8">
      {grupy}
    </p>
    <ul class="grid gap-3 list-none m-0 p-0 grid-cols-[repeat(auto-fill,minmax(14rem,1fr))] max-w-[52em]">
      {KAFELKI.map((k) => (
        <li>
          <a href={`/uk/${k.slug}/`}
             class="group flex flex-col border border-linia bg-tlo h-full hover:border-akcent">
            {k.obraz && (
              <span class="block overflow-hidden border-b border-linia">
                <Image src={k.obraz} alt={`Ілюстративне фото — ${k.nazwa.toLowerCase()}`}
                       widths={[320, 640]} sizes="(max-width: 640px) 100vw, 15rem"
                       loading="lazy" class="w-full h-28 object-cover object-[50%_25%]" />
              </span>
            )}
            <span class="px-5 py-4 font-semibold text-[15.5px] group-hover:text-akcent-ciemny">{k.nazwa}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="text-[15px] mt-6 mb-0">
      <a href="/zawody/" lang="pl" hreflang="pl"
         class="font-semibold text-akcent-tekst border-b-[1.5px] border-linia-mocna pb-0.5 hover:text-akcent-hover">Wszystkie zawody</a>
      <span class="text-tekst-drugi"> — усі професії, польською</span>
    </p>
  </section>

  <section class="bg-tlo-jasne border-y border-linia">
    <div class="max-w-[1200px] mx-auto px-5 py-16 lg:py-20">
      <h2 class="text-[clamp(1.6rem,4vw,2.5rem)] leading-tight mb-8">Найчастіші запитання</h2>
      <div class="border-t border-linia max-w-[52em]">
        {PYTANIA.map((p, i) => (
          <details class="border-b border-linia group" open={i < 2}>
            <summary class="cursor-pointer list-none py-5 flex gap-4 items-start justify-between font-semibold text-[17px]">
              {p.pytanie}
              <span aria-hidden="true" class="text-akcent-ciemny shrink-0 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="text-[16px] leading-relaxed text-tekst-drugi pb-5 mt-0 max-w-[46em]">{p.odpowiedz}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="max-w-[1200px] mx-auto px-5 py-14 flex flex-wrap gap-8 justify-between items-center">
      <div class="max-w-[38em]">
        <h2 class="text-[clamp(1.4rem,3vw,1.9rem)] leading-tight m-0 mb-2">Волієте поговорити?</h2>
        <p class="text-[16px] leading-relaxed text-tekst-drugi m-0">
          Заповнимо заявку разом, телефоном. Без зобов’язань. Розмова — польською мовою.
        </p>
      </div>
      <a href={`tel:${FIRMA.telefon}`} class="bg-akcent-ciemny text-white px-8 py-4 font-bold text-lg hover:bg-akcent-hover">
        {FIRMA.telefonWyswietlany}
      </a>
    </div>
  </section>
</Baza>
