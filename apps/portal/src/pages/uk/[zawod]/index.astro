---
/**
 * Strona zawodu po ukraińsku — ten sam układ co `src/pages/[zawod]/index.astro`.
 *
 * Powstaje tylko dla zawodów z `src/dane/uk/zawody.ts`; reszta zawodów ma
 * stronę wyłącznie po polsku. Treść redakcyjna to przekład polskiej, a kwoty
 * liczy ta sama `symuluj()` z tym samym dochodem przykładowym — strona
 * ukraińska nie może pokazać innej liczby niż polska dla tego samego zawodu
 * (pilnuje tego `test/uk.spec.js`).
 */
import { zawod, slugKategorii } from '@ud/zawody';
import Baza from '../../../layouts/Baza.astro';
import Kalkulator from '../../../components/Kalkulator.svelte';
import { symuluj, zl, zlZakres, LIMIT, MIESIECY_WYPLATY, MIESIECY_MAX } from '../../../lib/symulacja';
import { ZASILEK_JDG } from '../../../lib/zus';
import { graf, organizacja, serwis, strona, okruszki, usluga, faq } from '../../../lib/seo';
import { FIRMA } from '../../../lib/firma';
import { Image, getImage } from 'astro:assets';
import { obrazZawodu, obrazKategorii } from '../../../lib/obrazy';
import { ZAWODY_UK, zawodUk } from '../../../dane/uk/zawody';
import { GLOWNA_UK, ZUS_TEKST_UK, OPIS_KALIBRACJI_UK } from '../../../lib/uk';

export function getStaticPaths() {
  return ZAWODY_UK.map((z) => ({ params: { zawod: z.slug }, props: { slug: z.slug } }));
}

const { slug } = Astro.props;
const z = zawodUk(slug)!;
/** Dane liczbowe i kategoria — z polskiego rekordu zawodu, jedno źródło. */
const pl = zawod(slug)!;
const nazwaMala = z.nazwa.toLowerCase();

const sciezka = `/uk/${z.slug}/`;
const tytul = `Страхування від втрати доходу для ${z.dopelniacz} | UtrataDochodu.pl`;
const opis = `Скільки реально отримує ${nazwaMala} на лікарняному і як поліс закриває розрив між `
  + 'допомогою ZUS і доходом. Розрахунок внеску онлайн, пропозиція за 1–2 робочі дні.';

/** Ten sam dochód przykładowy co na stronie polskiej — z danych zawodu. */
const dochodPrzykladowy = pl.dochodPrzykladowy;
const wynik = symuluj({ dochod: dochodPrzykladowy });
const b2b = Math.round(LIMIT.b2b * 100);

/*
 * Zdania z kwotami składamy tutaj, a nie w szablonie: Astro gubi spację przy
 * przełamaniu linii obok {wyrażenia} i słowa sklejają się w pliku .md.
 * Każde jest przekładem zdania z polskiego szablonu `[zawod]/index.astro`.
 */
const zusOdpowiedz = `Допомога по хворобі — це ${ZUS_TEKST_UK.wzor}, а не 80% доходу. На повному ZUS `
  + '(duży ZUS) з найнижчою базою і з добровільним страхуванням на випадок хвороби це '
  + `${zl(ZASILEK_JDG.duzy)} на місяць до оподаткування, незалежно від заробітку; ${ZUS_TEKST_UK.dopiski}.`;
const zusPodpis = `Допомога ZUS, виплата за полісом та орієнтовний внесок при доході ${zl(dochodPrzykladowy)} на B2B`;
const zusPrzypis = 'Симуляція, а не пропозиція. Виплата щомісяця, щонайдовше протягом '
  + `${MIESIECY_MAX} місяців, залежно від варіанта; внесок стосується варіанта з виплатою до `
  + `${MIESIECY_WYPLATY} місяців. Допомога ZUS — ${ZUS_TEKST_UK.scenariusz}. ${ZUS_TEKST_UK.brutto} `
  + 'Внесок разом із дистрибуційною оплатою — діапазон від найдешевшої до найдорожчої ставки '
  + `${OPIS_KALIBRACJI_UK}. Реальний внесок розраховує система страховика після оцінки ризику.`;

const sciezkaOkruszkow = [
  { ...GLOWNA_UK },
  { nazwa: z.nazwa, url: sciezka },
];

const jsonld = graf([
  organizacja(),
  serwis(),
  okruszki(sciezkaOkruszkow),
  strona({ url: sciezka, tytul, opis, okruszki: sciezkaOkruszkow, jezyk: 'uk' }),
  usluga({
    nazwa: `Страхування від втрати доходу для ${z.dopelniacz}`,
    opis,
    url: sciezka,
    grupa: z.mnoga,
    typ: 'Страхування від втрати доходу',
  }),
  faq(z.pytania, sciezka),
]);

const inne = ZAWODY_UK.filter((i) => i.slug !== z.slug);

/**
 * Zdjęcie to samo co na stronie polskiej. Opis alternatywny idzie za tym, co
 * widać: własne zdjęcie zawodu opisujemy zawodem, odziedziczone — branżą.
 */
const wlasne = obrazZawodu(z.slug);
const obraz = wlasne ?? obrazKategorii(slugKategorii(pl.kategoria));
const opisZdjecia = `Ілюстративне фото — ${wlasne ? nazwaMala : `галузь ${z.kategoria}`}`;
const ogObraz = obraz
  ? (await getImage({ src: obraz, width: 1200, height: 630, format: 'jpg' })).src
  : undefined;
---
<Baza tytul={tytul} opis={opis} sciezka={sciezka} jsonld={jsonld} obraz={ogObraz} jezyk="uk">

  <nav aria-label="Навігаційний ланцюжок" class="bg-tlo-jasne border-b border-linia-lekka">
    <ol class="max-w-[1200px] mx-auto px-5 py-3 flex flex-wrap gap-2 items-center text-[13px] text-tekst-drugi list-none m-0">
      <li><a href={GLOWNA_UK.url} class="hover:text-akcent-ciemny">{GLOWNA_UK.nazwa}</a></li>
      <li aria-hidden="true">/</li>
      <li><span class="text-tekst font-semibold" aria-current="page">{z.nazwa}</span></li>
    </ol>
  </nav>

  <div class="relative isolate border-b border-linia bg-linear-102 from-tlo via-tlo-cyjan to-tlo-hero">
    {obraz && (
      <>
        <Image src={obraz} alt={opisZdjecia}
               widths={[768, 1280, 1920]} sizes="100vw"
               loading="eager" fetchpriority="high"
               class="absolute inset-0 -z-10 w-full h-full object-cover object-[50%_25%]" />
        <div class="absolute inset-0 -z-10 zaslona-hero" aria-hidden="true"></div>
      </>
    )}

    <div class={`max-w-[1200px] mx-auto px-5 flex flex-col justify-end ${obraz
      ? 'pt-[17rem] pb-16 lg:pt-24 lg:pb-24 min-h-[clamp(26rem,34vw,38rem)]'
      : 'py-16 lg:py-20'}`}>
      <div class="max-w-[36em]">
        <p class="font-mono text-xs tracking-[0.16em] uppercase text-akcent-tekst font-semibold m-0">
          {z.kategoria} · контракт B2B
        </p>
        <h1 class="mt-4 mb-5 text-[clamp(2rem,5vw,3.25rem)] leading-[1.06] max-w-[16em]">
          Страхування від втрати доходу для {z.dopelniacz}
        </h1>
        <p data-odpowiedz class="text-[clamp(1.05rem,2vw,1.16rem)] leading-relaxed text-tekst-drugi max-w-[34em] m-0">
          {z.wstep}
        </p>

        <div class="flex flex-wrap gap-3 mt-8">
          <a href="/uk/wniosek/"
             class="bg-akcent-ciemny text-white px-7 py-4 font-bold hover:bg-akcent-hover">
            Як подати заявку
          </a>
          <a href="/uk/wylaczenia/"
             class="border-[1.5px] border-akcent text-akcent-tekst bg-tlo px-7 py-[14px] font-semibold hover:bg-tlo-jasne">
            Що не покривається
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-5 py-16 lg:py-20 flex flex-col lg:flex-row gap-16">
    <div class="lg:w-[58em] flex flex-col gap-14 min-w-0">

      <section>
        <h2 class="text-[clamp(1.5rem,3vw,2rem)] leading-tight mb-3">
          Який вигляд має дохід у цій професії?
        </h2>
        <p data-odpowiedz class="text-lg leading-relaxed font-medium text-tekst m-0 mb-3">
          {z.dochod}
        </p>
      </section>

      <section>
        <h2 class="text-[clamp(1.5rem,3vw,2rem)] leading-tight mb-3">
          Що відбувається, коли {nazwaMala} не може працювати?
        </h2>
        <p data-odpowiedz class="text-[17px] leading-relaxed text-tekst-drugi m-0">
          {z.przerwa}
        </p>
      </section>

      <section>
        <h2 class="text-[clamp(1.5rem,3vw,2rem)] leading-tight mb-3">
          На що хворіє {nazwaMala}?
        </h2>
        <dl class="border-t border-linia m-0">
          {z.ryzyka.map((r) => (
            <div class="border-b border-linia py-5 flex flex-col sm:flex-row gap-2 sm:gap-8">
              <dt class="sm:w-[16em] shrink-0 font-semibold text-[16.5px]">{r.tytul}</dt>
              <dd class="m-0 text-[16px] leading-relaxed text-tekst-drugi">{r.opis}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section>
        <h2 class="text-[clamp(1.5rem,3vw,2rem)] leading-tight mb-3">
          Скільки {nazwaMala} отримає від ZUS на лікарняному?
        </h2>
        <p data-odpowiedz class="text-lg leading-relaxed font-medium text-tekst m-0 mb-6">{zusOdpowiedz}</p>

        <div class="border border-linia overflow-x-auto">
          <table class="w-full border-collapse text-left min-w-[20rem]">
            <caption class="sr-only">{zusPodpis}</caption>
            <tbody>
              <tr class="border-b border-linia">
                <th scope="row" class="px-6 py-4 font-semibold text-[15.5px]">Місячний дохід нетто</th>
                <td class="px-6 py-4 font-mono text-lg">{zl(dochodPrzykladowy)}</td>
              </tr>
              <tr class="border-b border-linia">
                <th scope="row" class="px-6 py-4 font-semibold text-[15.5px]">Допомога від ZUS (duży ZUS зі страхуванням на випадок хвороби)</th>
                <td class="px-6 py-4 font-mono text-lg text-alarm font-semibold">{zl(ZASILEK_JDG.duzy)}</td>
              </tr>
              <tr class="border-b border-linia">
                <th scope="row" class="px-6 py-4 font-semibold text-[15.5px]">Виплата за полісом ({b2b}% доходу)</th>
                <td class="px-6 py-4 font-mono text-lg text-akcent-ciemny font-semibold">{zl(wynik.swiadczenie)}</td>
              </tr>
              <tr class="bg-tlo-jasne">
                <th scope="row" class="px-6 py-5 font-semibold text-[16px]">Орієнтовний місячний внесок</th>
                <td class="px-6 py-5 font-mono text-xl font-semibold whitespace-nowrap">{zlZakres(wynik.skladkaOd, wynik.skladkaDo)}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="text-[13px] leading-relaxed text-tekst-drugi mt-4 mb-0">{zusPrzypis}</p>
      </section>

      <section>
        <h2 class="text-[clamp(1.5rem,3vw,2rem)] leading-tight mb-6">
          Запитання, які ставить {nazwaMala}
        </h2>
        <div class="border-t border-linia">
          {z.pytania.map((p) => (
            <details class="border-b border-linia group" open>
              <summary class="cursor-pointer list-none py-5 flex gap-4 items-start justify-between font-semibold text-[17px]">
                {p.pytanie}
                <span aria-hidden="true" class="text-akcent-ciemny shrink-0 group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="text-[16px] leading-relaxed text-tekst-drugi pb-5 mt-0 max-w-[46em]">{p.odpowiedz}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="border border-linia-mocna bg-tlo-jasne p-8">
        <h2 class="text-[clamp(1.35rem,2.5vw,1.7rem)] leading-tight m-0 mb-3">Перш ніж подати заявку — перевірте виключення</h2>
        <p class="text-[16px] leading-relaxed text-tekst-drugi m-0 mb-5">
          Професійне вигорання як самостійний діагноз, психічні захворювання як єдина причина
          непрацездатності (у CEU також без цієї умови), часткова непрацездатність і захворювання,
          які лікували протягом 24 місяців до укладення договору, не охоплені захистом.
        </p>
        <a href="/uk/wylaczenia/" class="font-semibold text-akcent-tekst border-b-[1.5px] border-linia-mocna pb-0.5 hover:text-akcent-hover">
          Повний список виключень
        </a>
      </section>
    </div>

    <aside class="lg:w-[24em] shrink-0 flex flex-col gap-5">
      <Kalkulator client:visible jezyk="uk" dochodPoczatkowy={dochodPrzykladowy} zawod={z.dopelniacz} />

      <div class="border border-linia bg-tlo-jasne p-6">
        <p class="text-[15px] leading-relaxed text-tekst-drugi m-0">
          Волієте розмову? Пройдемо заявку разом телефоном. Розмова польською мовою.
        </p>
        <a href={`tel:${FIRMA.telefon}`} class="inline-block mt-3 text-lg font-bold text-tekst hover:text-akcent-ciemny">
          {FIRMA.telefonWyswietlany}
        </a>
      </div>

      <nav aria-label="Інші професії" class="border border-linia bg-tlo-jasne p-7">
        <h2 class="font-mono text-[11px] tracking-[0.12em] uppercase text-tekst-drugi font-semibold m-0 mb-4">
          Інші професії українською
        </h2>
        <ul class="flex flex-wrap gap-2 list-none m-0 p-0">
          {inne.map((p) => (
            <li>
              <a href={`/uk/${p.slug}/`}
                 class="inline-block border border-linia bg-tlo px-3 py-1.5 text-[13.5px] text-tekst-drugi hover:border-akcent hover:text-akcent-ciemny">
                {p.nazwa}
              </a>
            </li>
          ))}
        </ul>
        <p class="text-[14px] mt-4 mb-0">
          <a href={`/zawody/${slugKategorii(pl.kategoria)}/`} lang="pl" hreflang="pl"
             class="font-semibold text-akcent-tekst hover:text-akcent-hover">Wszystkie zawody: {pl.kategoria}</a>
          <span class="text-tekst-drugi"> — польською</span>
        </p>
      </nav>
    </aside>
  </div>
</Baza>
