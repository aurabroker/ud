---
/**
 * Wyłączenia odpowiedzialności — po ukraińsku.
 *
 * PRZEKŁAD `src/pages/wylaczenia/index.astro`. Lista pozycji to przekład
 * `src/lib/wylaczenia.ts` (plik `src/dane/uk/wylaczenia.ts`), spięty z polskim
 * źródłem: paragrafy OWU przy każdej pozycji idą z polskiego pliku, a rozjazd
 * liczby grup albo pozycji przerywa build. Pytania są tłumaczone zdanie
 * w zdanie; `test/uk.spec.js` porównuje ich liczbę ze stroną polską.
 *
 * Do 26.11.2026 stało tu jedno zdanie dopisane tylko po ukraińsku (wojna) —
 * od wersji listy z 23.11.2026 polska pozycja mówi to samo, więc dopisku nie ma.
 *
 * HIV/WZW nie jest wyłączeniem — patrz CLAUDE.md. Na liście go nie ma, a pytanie
 * mówi to wprost, jak po polsku.
 */
import Baza from '../../../layouts/Baza.astro';
import { graf, organizacja, serwis, strona, okruszki, faq } from '../../../lib/seo';
import { FIRMA } from '../../../lib/firma';
import { GLOWNA_UK } from '../../../lib/uk';
import { ILE_POZYCJI, SPRAWDZONO } from '../../../lib/wylaczenia';
import { polaczone } from '../../../dane/uk/wylaczenia';

const sciezka = '/uk/wylaczenia/';
const tytul = 'Чого не покриває страхування від втрати доходу | UtrataDochodu.pl';
const opis = 'Повний список виключень із шести OWU: вагітність і пологи, психічні захворювання, '
  + 'хвороби, які лікували до договору, дегенеративні зміни, часткова непрацездатність. З параграфами.';

const GRUPY = polaczone();

const PYTANIA = [
  {
    pytanie: 'Чи покриває страхування від втрати доходу вагітність?',
    odpowiedz: 'Ні, якщо непрацездатність випливає з вагітності або пологів. Це виключають усі '
      + 'шість OWU, які ми пропонуємо: Leadenhall (LW044, LW046, LW047: § 11 ust. 1 lit. g) і CEU '
      + '(Utrata dochodu та dla zatrudniających: § 18 pkt 7, LOI Premium: § 13 pkt 7). Під час '
      + 'вагітності поліс виплатить кошти лише тоді, коли причиною непрацездатності є нещасний '
      + 'випадок або хвороба, не пов’язана з вагітністю. Дохід під час вагітності захищає допомога '
      + 'від ZUS — за підприємницької діяльності лише з добровільним страхуванням на випадок хвороби.',
  },
  {
    pytanie: 'Чи покриває страхування від втрати доходу депресію?',
    odpowiedz: 'У CEU — ні: OWU виключають непрацездатність, причиною якої була депресія, невроз, '
      + 'психоз, тривожні стани, стрес, перевтома або емоційний розлад. Leadenhall виключає невроз, '
      + 'психоневроз, психопатію, психоз, тривожні стани, стрес, перевтому, душевні хвороби та '
      + 'емоційний розлад, але лише тоді, коли вони є єдиною причиною непрацездатності; депресії '
      + 'окремо не називає. Коли працювати не дає також соматична хвороба, охоплена захистом, '
      + 'враховують цю хворобу.',
  },
  {
    pytanie: 'Чи спрацює поліс у разі професійного вигорання?',
    odpowiedz: 'Ні, якщо вигорання — єдиний діагноз. Професійне вигорання не є нозологічною '
      + 'одиницею в класифікації ICD (МКХ), тож не є підставою для виплати.',
  },
  {
    pytanie: 'Чи отримаю виплату, якщо можу працювати в меншому обсязі?',
    odpowiedz: 'Ні. Виплата належить за повну нездатність працювати за професією. Часткова '
      + 'непрацездатність виплати не запускає. Виняток — опційна клаузула 9 у CEU: вона охоплює '
      + 'часткову непрацездатність, але лише після нещасного випадку.',
  },
  {
    pytanie: 'Що буде, якщо я не повідомлю про попереднє лікування?',
    odpowiedz: 'Страховик не відповідає за наслідки обставин, про які він запитував, але які йому '
      + 'не було вказано (ст. 815 Цивільного кодексу Польщі). Повідомлення про захворювання не '
      + 'означає автоматичної відмови: страховик може прийняти його до захисту, підвищити внесок '
      + 'або виключити його. Рішення видно в пропозиції, перш ніж ви щось підпишете.',
  },
  {
    pytanie: 'Чи охоплює захист зараження ВІЛ або вірусним гепатитом на роботі?',
    odpowiedz: 'Саме зараження не виключено. Якщо воно призведе до непрацездатності, її оцінюють '
      + 'на загальних засадах — як за будь-якої іншої хвороби. Особливі умови HIV/WZW (LW048 до '
      + 'варіанта MEDICA, LW049 до MEDICARE) додатково дають окрему виплату за саме зараження після '
      + 'ненавмисного контакту з кров’ю або біологічними рідинами на роботі: одноразову виплату '
      + '(за гепатиту B або C — після 12-місячного періоду очікування) та відшкодування вартості '
      + 'антиретровірусних препаратів до 5 000 zł і консультацій з аналізами до 2 000 zł.',
  },
];

const sciezkaOkruszkow = [
  GLOWNA_UK,
  { nazwa: 'Що не покривається', url: sciezka },
];

const jsonld = graf([
  organizacja(),
  serwis(),
  okruszki([...sciezkaOkruszkow]),
  strona({ url: sciezka, tytul, opis, okruszki: [...sciezkaOkruszkow], jezyk: 'uk' }),
  faq(PYTANIA, sciezka),
]);

const ile = ILE_POZYCJI;

/* Zdania z liczbami składamy tutaj — Astro gubi spację obok {wyrażenia} na końcu linii. */
const wstep = `Виключень із шести OWU — ${ile}, і всі вони зібрані в одному місці, перш ніж ви `
  + 'заповните заявку. Найважливіші: вагітність і пологи (виключені в усіх шести OWU), психічні '
  + 'захворювання як єдина причина непрацездатності (у CEU також без цієї умови), хвороби, які '
  + 'лікували протягом 24 місяців до страхування, дегенеративні зміни в Leadenhall і часткова '
  + 'непрацездатність.';
const oLiscie = `Список є стислим викладом і перекладом польської сторінки, звіреної з текстом OWU `
  + `${SPRAWDZONO}. Біля кожної позиції подано параграфи. Обов’язковим є текст загальних умов `
  + 'страхування (OWU) польською мовою —';
---
<Baza tytul={tytul} opis={opis} sciezka={sciezka} jsonld={jsonld} jezyk="uk">
  <div class="bg-tlo-jasne border-b border-linia">
    <div class="max-w-[1200px] mx-auto px-5 py-14 lg:py-18">
      <nav aria-label="Навігаційний ланцюжок" class="mb-5">
        <ol class="flex flex-wrap gap-2 text-[13px] text-tekst-drugi list-none m-0 p-0">
          <li><a href={GLOWNA_UK.url} class="hover:text-akcent-ciemny">{GLOWNA_UK.nazwa}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-tekst">Що не покривається</li>
        </ol>
      </nav>
      <h1 class="text-[clamp(1.9rem,5vw,3rem)] leading-[1.08] max-w-[16em] m-0">
        Чого це страхування не покриває
      </h1>
      <p data-odpowiedz class="text-[1.12rem] leading-relaxed text-tekst-drugi max-w-[42em] mt-6 mb-0">{wstep}</p>
      <p class="text-[15px] leading-relaxed text-tekst-drugi max-w-[42em] mt-4 mb-0">
        {oLiscie}{' '}
        <a href="/dokumenty/" lang="pl" hreflang="pl" class="text-akcent-tekst underline decoration-linia-mocna underline-offset-2">OWU i karty produktu</a>.
      </p>
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-5 py-14 flex flex-col gap-12">
    {GRUPY.map((g, i) => (
      <section aria-labelledby={`g-${i + 1}`}>
        <h2 id={`g-${i + 1}`}
            class="text-[clamp(1.35rem,3vw,1.8rem)] pb-3 mb-6 border-b-2 border-akcent">
          {g.tytul}
        </h2>
        <ul class="list-none m-0 p-0 grid gap-x-10 gap-y-7 grid-cols-[repeat(auto-fill,minmax(21rem,1fr))]">
          {g.pozycje.map((p) => (
            <li class="border-l-[3px] border-alarm pl-5">
              <h3 class="text-[17px] font-semibold m-0 mb-2 leading-snug">{p.co}</h3>
              <p class="text-[15px] leading-relaxed text-tekst-drugi m-0">{p.czemu}</p>
              {/* Paragrafy w zapisie polskim — pod takim klient znajdzie je w OWU. */}
              <p class="text-[13px] leading-relaxed text-tekst-drugi mt-2 mb-0">Джерело: <span lang="pl">{p.zrodla}</span></p>
              {p.wiecej && (
                <p class="text-[15px] leading-relaxed mt-2 mb-0">
                  Докладніше (польською):{' '}
                  <a href={p.wiecej.url} lang="pl" hreflang="pl" class="text-akcent-tekst underline decoration-linia-mocna underline-offset-2">{p.wiecej.tekst}</a>
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <section class="bg-tlo-jasne border-y border-linia">
    <div class="max-w-[1200px] mx-auto px-5 py-14">
      <h2 class="text-[clamp(1.5rem,3.5vw,2.1rem)] leading-tight mb-8">Найчастіші запитання про виключення</h2>
      <div class="border-t border-linia max-w-[52em]">
        {PYTANIA.map((p, i) => (
          <details class="border-b border-linia group" open={i < 2}>
            <summary class="cursor-pointer list-none py-5 flex gap-4 items-start justify-between font-semibold text-[17px]">
              {p.pytanie}
              <span aria-hidden="true" class="text-akcent-ciemny shrink-0 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="text-[16px] leading-relaxed text-tekst-drugi pb-5 mt-0 max-w-[46em]">{p.odpowiedz}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-[1200px] mx-auto px-5 py-14 flex flex-wrap gap-8 justify-between items-center">
    <div class="max-w-[38em]">
      <h2 class="text-[clamp(1.3rem,3vw,1.8rem)] leading-tight m-0 mb-2">Не впевнені, чи ваш випадок охоплено?</h2>
      <p class="text-[16px] leading-relaxed text-tekst-drugi m-0">
        Зателефонуйте й запитайте прямо, перш ніж заповнювати заявку. Це коротший шлях, ніж
        читати сто сторінок умов. Розмова — польською мовою.
      </p>
    </div>
    <a href={`tel:${FIRMA.telefon}`} class="bg-akcent-ciemny text-white px-8 py-4 font-bold text-lg hover:bg-akcent-hover">
      {FIRMA.telefonWyswietlany}
    </a>
  </div>
</Baza>
