---
/**
 * Baza.astro — szkielet każdej strony portalu.
 *
 * Kolejność w <head> nie jest przypadkowa:
 * 1. <meta charset> jako pierwszy — przeglądarka szuka deklaracji kodowania
 *    tylko w pierwszym kilobajcie pliku. W starym index.html wpis wylądował
 *    za skryptem Meta Pixela, na bajcie 1812, i był ignorowany; polskie znaki
 *    ratował wyłącznie nagłówek od Cloudflare.
 * 2. Fonty i CSS — zasoby blokujące render, im wcześniej tym lepszy LCP.
 * 3. Skrypty analityczne dopiero na końcu <body>, zawsze odroczone.
 */
import { SERWIS } from '../lib/firma';
import { TAGI } from '../lib/analityka';
import Nawigacja from '../components/Nawigacja.astro';
import Stopka from '../components/Stopka.astro';
import { Font } from 'astro:assets';
import { hreflangi, type Jezyk } from '../lib/jezyki';
import '../styles/global.css';

interface Props {
  tytul: string;
  opis: string;
  /** Ścieżka względna, np. „/lekarz/". Kanoniczny adres składamy z niej. */
  sciezka: string;
  /** Gotowy JSON-LD (string) — patrz lib/seo.ts. */
  jsonld?: string;
  /**
   * Obrazek Open Graph — ścieżka na naszej domenie albo pełny adres;
   * domyślnie karta marki `/og-domyslny.jpg`. Plik musi istnieć: 404 pod
   * og:image to podgląd linku bez obrazka (pilnuje test/og.spec.js).
   */
  obraz?: string;
  /** Wyłącza indeksowanie — dla podziękowania i stron technicznych. */
  bezIndeksu?: boolean;
  /**
   * Czy obok tej strony leży bliźniaczy plik `.md`.
   *
   * Integracja `ud:markdown` przerabia wyłącznie pliki `index.html`, więc
   * strona zbudowana jako `404.html` wariantu nie dostaje. Ogłaszanie go
   * nagłówkiem `<link rel="alternate">` prowadziłoby agenta w pustkę.
   */
  wariantMarkdown?: boolean;
  /**
   * Język treści strony. Domyślnie polski; „uk" dla podstron pod `/uk/`.
   * Od niego zależą `lang`, nawigacja, stopka i kroje pisma (niżej).
   */
  jezyk?: Jezyk;
  /**
   * Czy strona ma adres kanoniczny. Wyłącza go strona 404: Pages podaje ją
   * pod KAŻDYM nieznanym adresem, a odnośnik na „/404/" wskazywałby adres,
   * który sam przekierowuje — sprzeczny sygnał dla robota.
   */
  kanoniczny?: boolean;
  /**
   * Wpis z bazy wiedzy: og:type „article" z datami publikacji i zmiany
   * (te same, co datePublished/dateModified w JSON-LD i <lastmod> w mapie).
   */
  artykul?: { opublikowano: string; zmieniono: string };
}

const {
  tytul, opis, sciezka, jsonld, obraz, bezIndeksu = false, wariantMarkdown = true,
  kanoniczny: zKanonicznym = true, artykul, jezyk = 'pl',
} = Astro.props;
const kanoniczny = new URL(sciezka, SERWIS.url).href;

/** Ta sama strona w drugim języku — puste, gdy przekładu nie ma. */
const wersje = hreflangi(sciezka, jezyk);

const NAPISY = {
  pl: {
    skok: 'Przejdź do treści', ogLocale: 'pl_PL',
    ogOpis: `${SERWIS.nazwa} — ubezpieczenie utraty dochodu dla specjalistów i przedsiębiorców`,
  },
  uk: {
    skok: 'Перейти до змісту', ogLocale: 'uk_UA',
    ogOpis: `${SERWIS.nazwa} — страхування від втрати доходу для спеціалістів і підприємців`,
  },
}[jezyk];

/**
 * Kroje dla cyrylicy.
 *
 * Newsreader i Public Sans nie mają cyrylicy (Google Fonts podaje dla nich
 * tylko zestawy łacińskie), więc na stronie ukraińskiej przeglądarka brałaby
 * z nich cyfry i wstawki łacińskie („ZUS", „B2B"), a litery ukraińskie z kroju
 * zastępczego — dwa kroje w jednym zdaniu. Dlatego wersja ukraińska dostaje
 * same kroje systemowe: wszystkie znaki z jednego kroju i zero pobierania.
 * Zmienne noszą te same nazwy, więc reszta arkusza nie wie o różnicy.
 */
const KROJE_UK = ':root{'
  + '--font-naglowek:Georgia,"Times New Roman","Noto Serif",serif;'
  + '--font-tekst:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans",sans-serif;'
  + '--font-mono:ui-monospace,SFMono-Regular,Menlo,Consolas,"Liberation Mono",monospace;}';

/**
 * Domyślny obrazek Open Graph: karta marki 1200 × 630 z `public/` (źródło:
 * scripts/og-domyslny.html, odtwarzane skryptem og-domyslny.mjs). Wymiary
 * i opis podajemy tylko dla niej — wymiarów obrazka przekazanego przez stronę
 * tu nie znamy, a zgadnięte byłyby gorsze niż żadne. Napis na samej karcie
 * jest po polsku; opis alternatywny idzie w języku strony.
 */
const OG_DOMYSLNY = {
  sciezka: '/og-domyslny.jpg',
  szerokosc: 1200,
  wysokosc: 630,
  opis: NAPISY.ogOpis,
};
const ogObraz = new URL(obraz ?? OG_DOMYSLNY.sciezka, SERWIS.url).href;
---
<!doctype html>
<html lang={jezyk}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!--
    Dwa skrypty muszą wykonać się przed wszystkim innym i dlatego są tu,
    bez `defer`, przed jakimkolwiek innym zasobem:

    awaria.js — inaczej nie złapie błędu skryptu, który wysypie się wcześniej.
    zgody.js  — ustawia domyślne odmowy Consent Mode i decyduje, czy tagi
                w ogóle wolno załadować. Uruchomiony później oznaczałby, że
                pierwsza odsłona poleci do Google, zanim ktokolwiek się zgodzi.

    Oba są krótkie i lokalne, więc koszt blokowania jest pomijalny —
    a odwrócenie tej kolejności robi z obu atrapy.

    Uwaga: `<meta charset>` musi zostać w pierwszym kilobajcie pliku.
    Te dwa wpisy są krótkie i mieszczą się przed nim bez ryzyka.
  -->
  <script is:inline define:vars={{ TAGI }}>window.UD_TAGI = TAGI;</script>
  <script is:inline src="/awaria.js"></script>
  <script is:inline src="/zgody.js"></script>
  {/* zrodlo.js — niesie parametry kampanii (gclid, utm_*…) w adresie między
      podstronami, dokleja je do odnośników w chwili kliknięcia; niczego nie
      zapisuje w urządzeniu. `defer`: nie musi wyprzedzać niczego, a nie może
      blokować renderu. Opis w samym pliku. */}
  <script is:inline src="/zrodlo.js" defer></script>

  <title>{tytul}</title>
  <meta name="description" content={opis}>
  {zKanonicznym && <link rel="canonical" href={kanoniczny}>}
  {/* Wzajemne wskazanie wersji językowych: obie strony pary wymieniają obie
      wersje i siebie. Bez wzajemności wyszukiwarka pomija cały zestaw. */}
  {wersje.map((w) => (
    <link rel="alternate" hreflang={w.hreflang} href={new URL(w.sciezka, SERWIS.url).href} />
  ))}

  {wariantMarkdown && (
    <>
      {/* Ta sama treść bez nawigacji, stopki i wysp — dla agentów, które przyszły
          po tekst, a nie po stronę. To samo wraca pod adresem strony, gdy żądanie
          ma nagłówek `Accept: text/markdown` (obsługa: functions/_middleware.js). */}
      <link rel="alternate" type="text/markdown" href={`${sciezka}index.md`} />
    </>
  )}
  {bezIndeksu
    ? <meta name="robots" content="noindex, follow">
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">}

  {jezyk === 'uk'
    ? <style is:inline set:html={KROJE_UK}></style>
    : (
      <>
        <Font cssVariable="--font-naglowek" preload />
        <Font cssVariable="--font-tekst" preload />
        <Font cssVariable="--font-mono" />
      </>
    )}

  <meta property="og:type" content={artykul ? 'article' : 'website'}>
  {artykul && (
    <>
      <meta property="article:published_time" content={artykul.opublikowano}>
      <meta property="article:modified_time" content={artykul.zmieniono}>
    </>
  )}
  <meta property="og:locale" content={NAPISY.ogLocale}>
  <meta property="og:site_name" content={SERWIS.nazwa}>
  <meta property="og:title" content={tytul}>
  <meta property="og:description" content={opis}>
  {zKanonicznym && <meta property="og:url" content={kanoniczny}>}
  <meta property="og:image" content={ogObraz}>
  {!obraz && (
    <>
      <meta property="og:image:type" content="image/jpeg">
      <meta property="og:image:width" content={String(OG_DOMYSLNY.szerokosc)}>
      <meta property="og:image:height" content={String(OG_DOMYSLNY.wysokosc)}>
      <meta property="og:image:alt" content={OG_DOMYSLNY.opis}>
    </>
  )}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={tytul}>
  <meta name="twitter:description" content={opis}>
  <meta name="twitter:image" content={ogObraz}>
  {!obraz && <meta name="twitter:image:alt" content={OG_DOMYSLNY.opis}>}

  {jsonld && <script type="application/ld+json" set:html={jsonld} />}

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {/* Kanał bloga jest po polsku — na stronie ukraińskiej nie ogłaszamy go jako jej wariantu. */}
  {jezyk === 'pl' && <link rel="alternate" type="application/rss+xml" title="Baza wiedzy UtrataDochodu.pl" href="/blog/rss.xml">}
</head>

<body class="bg-tlo text-tekst antialiased">
  <!-- Wymóg dostępności: pierwszym elementem w kolejności tabulacji musi być
       skok do treści, inaczej użytkownik klawiatury przechodzi całą nawigację
       na każdej podstronie z osobna. -->
  <a href="#tresc"
     class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50
            focus:bg-akcent-ciemny focus:text-white focus:px-4 focus:py-2 focus:font-semibold">
    {NAPISY.skok}
  </a>

  <Nawigacja sciezka={sciezka} jezyk={jezyk} />

  <main id="tresc">
    <slot />
  </main>

  <Stopka sciezka={sciezka} jezyk={jezyk} />
</body>
</html>
