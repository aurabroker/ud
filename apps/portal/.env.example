# Zmienne budowania portalu.
#
# Wszystkie mają przedrostek PUBLIC_, bo trafiają do kodu strony i są widoczne
# dla każdego, kto otworzy podgląd źródła. To NIE są sekrety — sekrety
# (TURNSTILE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY) żyją po stronie funkcji
# brzegowych i w panelu Cloudflare.
#
# Każda zmienna ma sensowną wartość domyślną w kodzie, więc build bez tego
# pliku się powiedzie — ale wtedy portal użyje identyfikatorów wpisanych
# na sztywno. W środowisku produkcyjnym ustaw je jawnie.

# ── Supabase ────────────────────────────────────────────────────────────────
PUBLIC_SUPABASE_URL=https://kukvgsjrmrqtzhkszzum.supabase.co

# ── Cloudflare Turnstile ────────────────────────────────────────────────────
# Klucz witryny, publiczny z definicji. Bez niego formularze działają,
# ale bez ochrony przed botami.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADgSxo_FfjvXKO29

# ── Analityka ───────────────────────────────────────────────────────────────
# Uruchamiana wyłącznie po zgodzie użytkownika — patrz public/zgody.js.
# Pusta wartość = tag nie zostanie w ogóle załadowany.
PUBLIC_GA4_ID=G-MGB0RBTCC9
PUBLIC_ADS_ID=AW-18020137303
PUBLIC_META_PIXEL_ID=4299065913693248

# Etykieta konwersji Google Ads dla złożonego wniosku (strona /podziekowanie/).
PUBLIC_ADS_KONWERSJA=_uZeCOTG_KwcENfy1ZBD
